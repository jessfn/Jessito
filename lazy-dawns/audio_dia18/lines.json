{"lines": [{"id": "i1", "who": "D", "text": "Ella cree que hoy se arregla sola. Qué ingenua.", "pad": 0.6, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["Ella", 0.6, 0.92], ["cree", 0.96, 1.16], ["que", 1.24, 1.32], ["hoy", 1.4, 1.56], ["se", 1.64, 1.72], ["arregla", 1.76, 2.04], ["sola.", 2.12, 2.52], ["Qué", 2.92, 3.08], ["ingenua.", 3.24, 3.96]], "dur": 3.395918, "start": 0.6, "end": 3.996}, {"id": "i2", "who": "D", "text": "Mientras se mira al espejo, yo ya tengo a alguien que no puede volver.", "pad": 0.25, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["Mientras", 4.246, 4.646], ["se", 4.726, 4.806], ["mira", 4.846, 4.966], ["al", 5.006, 5.046], ["espejo,", 5.126, 6.006], ["yo", 6.086, 6.246], ["ya", 6.286, 6.326], ["tengo", 6.486, 6.726], ["a", 6.766, 6.806], ["alguien", 6.926, 7.206], ["que", 7.286, 7.446], ["no", 7.526, 7.606], ["puede", 7.766, 8.006], ["volver.", 8.046, 8.806]], "dur": 4.519184, "start": 4.246, "end": 8.765}, {"id": "l1", "who": "N", "text": "Día dieciocho. Eligieron el maquillaje. Y todo empezó en mi casa.", "pad": 4.3, "words": [["Día", 13.065, 13.385], ["dieciocho.", 13.465, 14.585], ["Eligieron", 14.665, 15.065], ["el", 15.145, 15.185], ["maquillaje.", 15.225, 16.265], ["Y", 16.305, 16.345], ["todo", 16.505, 16.745], ["empezó", 16.825, 17.225], ["en", 17.265, 17.305], ["mi", 17.385, 17.465], ["casa.", 17.545, 18.185]], "dur": 5.067755, "start": 13.065, "end": 18.133}, {"id": "l2", "who": "Y", "text": "Ya estamos en tu casa, Lazy. Te acompañé hasta la puerta. Aquí estarás a salvo.", "pad": 0.2, "words": [["Ya", 18.333, 18.493], ["estamos", 18.573, 18.893], ["en", 18.933, 18.973], ["tu", 19.053, 19.133], ["casa,", 19.213, 19.573], ["Lazy.", 19.613, 20.413], ["Te", 20.493, 20.533], ["acompañé", 20.573, 21.053], ["hasta", 21.106, 21.213], ["la", 21.293, 21.373], ["puerta.", 21.453, 22.253], ["Aquí", 22.333, 22.653], ["estarás", 22.813, 23.213], ["a", 23.253, 23.293], ["salvo.", 23.413, 24.013]], "dur": 5.642449, "start": 18.333, "end": 23.975}, {"id": "l4", "who": "S", "text": "Hija, ¿qué te pasó? Ven, siéntate. Primero te limpiamos la cara con calma.", "pad": 1.3, "words": [["Hija,", 25.275, 25.915], ["¿qué", 25.942, 25.995], ["te", 26.075, 26.235], ["pasó?", 26.355, 26.795], ["Ven,", 27.195, 27.595], ["siéntate.", 27.675, 28.555], ["Primero", 28.675, 28.955], ["te", 28.995, 29.035], ["limpiamos", 29.115, 29.595], ["la", 29.635, 29.675], ["cara", 29.755, 29.995], ["con", 30.075, 30.235], ["calma.", 30.315, 31.035]], "dur": 5.720816, "start": 25.275, "end": 30.996}, {"id": "l5", "who": "N", "text": "Mi mamá, doña Susan, abrió su tocador.", "pad": 0.15, "words": [["Mi", 31.146, 31.306], ["mamá,", 31.346, 32.026], ["doña", 32.106, 32.346], ["Susan,", 32.426, 33.226], ["abrió", 33.306, 33.626], ["su", 33.706, 33.786], ["tocador.", 33.866, 34.506]], "dur": 3.395918, "start": 31.146, "end": 34.542}, {"id": "l8", "who": "S", "text": "Ahora la sombra. Vino y ciruela, con un poco de brillo arriba. Cierra los ojos.", "pad": 3.8, "words": [["Ahora", 38.342, 38.742], ["la", 38.902, 38.982], ["sombra.", 39.062, 39.542], ["Vino", 40.102, 40.422], ["y", 40.462, 40.502], ["ciruela,", 40.582, 41.222], ["con", 41.382, 41.462], ["un", 41.542, 41.622], ["poco", 41.782, 42.022], ["de", 42.102, 42.182], ["brillo", 42.222, 42.502], ["arriba.", 42.542, 43.382], ["Cierra", 43.462, 43.702], ["los", 43.782, 43.862], ["ojos.", 43.942, 44.582]], "dur": 6.19102, "start": 38.342, "end": 44.533}, {"id": "l10", "who": "S", "text": "Y para terminar, un rubor cálido, y labios rojo oscuro. Mírate.", "pad": 3.3, "words": [["Y", 47.833, 47.913], ["para", 47.993, 48.153], ["terminar,", 48.313, 49.113], ["un", 49.193, 49.273], ["rubor", 49.353, 49.673], ["cálido,", 49.753, 50.553], ["y", 50.633, 50.793], ["labios", 50.873, 51.273], ["rojo", 51.353, 51.593], ["oscuro.", 51.673, 52.553], ["Mírate.", 52.593, 53.353]], "dur": 5.485714, "start": 47.833, "end": 53.319}, {"id": "l12", "who": "Y", "text": "Lazy... estás hermosa.", "pad": 0.2, "words": [["Lazy...", 53.519, 54.479], ["estás", 54.559, 54.959], ["hermosa.", 55.119, 56.079]], "dur": 2.586122, "start": 53.519, "end": 56.105}, {"id": "l13", "who": "N", "text": "Y entonces, los tres celulares sonaron a la vez.", "pad": 0.5, "words": [["Y", 56.605, 56.685], ["entonces,", 56.805, 57.645], ["los", 57.725, 57.885], ["tres", 58.045, 58.285], ["celulares", 58.365, 58.845], ["sonaron", 58.965, 59.325], ["a", 59.365, 59.405], ["la", 59.445, 59.485], ["vez.", 59.565, 60.205]], "dur": 3.552653, "start": 56.605, "end": 60.158}, {"id": "l14", "who": "T", "text": "Última hora. La joven Mari desapareció anoche, camino a casa de una amiga.", "pad": 0.3, "words": [["Última", 60.458, 60.938], ["hora.", 61.098, 61.338], ["La", 61.818, 61.898], ["joven", 61.938, 62.218], ["Mari", 62.298, 62.538], ["desapareció", 62.658, 63.258], ["anoche,", 63.378, 63.978], ["camino", 64.098, 64.378], ["a", 64.418, 64.458], ["casa", 64.498, 64.778], ["de", 64.818, 64.858], ["una", 64.938, 65.098], ["amiga.", 65.178, 65.738]], "dur": 5.32898, "start": 60.458, "end": 65.787}, {"id": "l15", "who": "N", "text": "Mari. Iba a verla anoche, y nunca llegué.", "pad": 0.3, "words": [["Mari.", 66.087, 66.887], ["Iba", 67.127, 67.367], ["a", 67.394, 67.42], ["verla", 67.447, 67.687], ["anoche,", 67.847, 68.567], ["y", 68.607, 68.647], ["nunca", 68.727, 68.967], ["llegué.", 69.047, 69.687]], "dur": 3.552653, "start": 66.087, "end": 69.64}, {"id": "l17", "who": "S", "text": "Hija, tranquila. Llamemos a la policía. Pero así no puedes salir.", "pad": 2.4, "words": [["Hija,", 72.04, 72.6], ["tranquila.", 72.68, 73.48], ["Llamemos", 73.64, 74.04], ["a", 74.08, 74.12], ["la", 74.16, 74.2], ["policía.", 74.28, 75.16], ["Pero", 75.2, 75.4], ["así", 75.48, 75.64], ["no", 75.72, 75.88], ["puedes", 75.933, 76.2], ["salir.", 76.32, 76.92]], "dur": 4.832653, "start": 72.04, "end": 76.873}, {"id": "l18", "who": "N", "text": "Mi cabello era un desastre. Pero no podía esperar.", "pad": 0.2, "words": [["Mi", 77.073, 77.233], ["cabello", 77.273, 77.713], ["era", 77.873, 78.033], ["un", 78.113, 78.193], ["desastre.", 78.273, 79.433], ["Pero", 79.633, 79.873], ["no", 80.033, 80.193], ["podía", 80.313, 80.593], ["esperar.", 80.753, 81.473]], "dur": 4.362449, "start": 77.073, "end": 81.435}, {"id": "l19", "who": "Y", "text": "Iremos juntos, Lazy. Pero primero, ¿qué prefieres arreglar?", "pad": 0.2, "words": [["Iremos", 81.635, 82.035], ["juntos,", 82.115, 82.648], ["Lazy.", 82.782, 82.995], ["Pero", 83.395, 83.635], ["primero,", 83.795, 84.275], ["¿qué", 84.595, 84.675], ["prefieres", 84.755, 85.235], ["arreglar?", 85.275, 85.955]], "dur": 4.284082, "start": 81.635, "end": 85.919}, {"id": "l20", "who": "N", "text": "Cabello o piel. Comenta tu elección y sígueme para el día diecinueve.", "pad": 0.35, "words": [["Cabello", 86.269, 86.829], ["o", 86.989, 87.069], ["piel.", 87.149, 87.789], ["Comenta", 88.029, 88.349], ["tu", 88.389, 88.429], ["elección", 88.509, 89.069], ["y", 89.149, 89.229], ["sígueme", 89.389, 89.789], ["para", 89.869, 90.029], ["el", 90.069, 90.109], ["día", 90.189, 90.349], ["diecinueve.", 90.429, 91.309]], "dur": 4.989388, "start": 86.269, "end": 91.258}], "total": 92.26}