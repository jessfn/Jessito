{"lines": [{"id": "i1", "who": "D", "text": "Ella cree que hoy se arregla sola. Qué ingenua.", "pad": 0.6, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["Ella", 0.6, 0.92], ["cree", 0.96, 1.16], ["que", 1.24, 1.32], ["hoy", 1.4, 1.56], ["se", 1.64, 1.72], ["arregla", 1.76, 2.04], ["sola.", 2.12, 2.52], ["Qué", 2.92, 3.08], ["ingenua.", 3.24, 3.96]], "dur": 3.395918, "start": 0.6, "end": 3.996}, {"id": "i2", "who": "D", "text": "Mientras se mira al espejo, yo ya tengo a alguien que no puede volver.", "pad": 0.25, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["Mientras", 4.246, 4.646], ["se", 4.726, 4.806], ["mira", 4.846, 4.966], ["al", 5.006, 5.046], ["espejo,", 5.126, 6.006], ["yo", 6.086, 6.246], ["ya", 6.286, 6.326], ["tengo", 6.486, 6.726], ["a", 6.766, 6.806], ["alguien", 6.926, 7.206], ["que", 7.286, 7.446], ["no", 7.526, 7.606], ["puede", 7.766, 8.006], ["volver.", 8.046, 8.806]], "dur": 4.519184, "start": 4.246, "end": 8.765}, {"id": "l1", "who": "N", "text": "Día dieciocho. Eligieron el maquillaje. Y todo empezó en mi casa.", "pad": 3.9, "words": [["Día", 12.665, 12.985], ["dieciocho.", 13.065, 14.185], ["Eligieron", 14.265, 14.665], ["el", 14.745, 14.785], ["maquillaje.", 14.825, 15.865], ["Y", 15.905, 15.945], ["todo", 16.105, 16.345], ["empezó", 16.425, 16.825], ["en", 16.865, 16.905], ["mi", 16.985, 17.065], ["casa.", 17.145, 17.785]], "dur": 5.067755, "start": 12.665, "end": 17.733}, {"id": "l2", "who": "Y", "text": "Ya estamos en tu casa, Lazy. Te acompañé hasta la puerta. Aquí estarás a salvo.", "pad": 0.15, "words": [["Ya", 17.883, 18.043], ["estamos", 18.123, 18.443], ["en", 18.483, 18.523], ["tu", 18.603, 18.683], ["casa,", 18.763, 19.123], ["Lazy.", 19.163, 19.963], ["Te", 20.043, 20.083], ["acompañé", 20.123, 20.603], ["hasta", 20.656, 20.763], ["la", 20.843, 20.923], ["puerta.", 21.003, 21.803], ["Aquí", 21.883, 22.203], ["estarás", 22.363, 22.763], ["a", 22.803, 22.843], ["salvo.", 22.963, 23.563]], "dur": 5.642449, "start": 17.883, "end": 23.525}, {"id": "l4", "who": "S", "text": "Hija, ¿qué te pasó? Ven, siéntate. Primero te limpiamos la cara con calma.", "pad": 0.15, "words": [["Hija,", 23.675, 24.315], ["¿qué", 24.342, 24.395], ["te", 24.475, 24.635], ["pasó?", 24.755, 25.195], ["Ven,", 25.595, 25.995], ["siéntate.", 26.075, 26.955], ["Primero", 27.075, 27.355], ["te", 27.395, 27.435], ["limpiamos", 27.515, 27.995], ["la", 28.035, 28.075], ["cara", 28.155, 28.395], ["con", 28.475, 28.635], ["calma.", 28.715, 29.435]], "dur": 5.720816, "start": 23.675, "end": 29.396}, {"id": "l5", "who": "N", "text": "Mi mamá, doña Susan, abrió su tocador.", "pad": 0.15, "words": [["Mi", 29.546, 29.706], ["mamá,", 29.746, 30.426], ["doña", 30.506, 30.746], ["Susan,", 30.826, 31.626], ["abrió", 31.706, 32.026], ["su", 32.106, 32.186], ["tocador.", 32.266, 32.906]], "dur": 3.395918, "start": 29.546, "end": 32.942}, {"id": "l8", "who": "S", "text": "Ahora la sombra. Vino y ciruela, con un poco de brillo arriba. Cierra los ojos.", "pad": 0.15, "words": [["Ahora", 33.092, 33.492], ["la", 33.652, 33.732], ["sombra.", 33.812, 34.292], ["Vino", 34.852, 35.172], ["y", 35.212, 35.252], ["ciruela,", 35.332, 35.972], ["con", 36.132, 36.212], ["un", 36.292, 36.372], ["poco", 36.532, 36.772], ["de", 36.852, 36.932], ["brillo", 36.972, 37.252], ["arriba.", 37.292, 38.132], ["Cierra", 38.212, 38.452], ["los", 38.532, 38.612], ["ojos.", 38.692, 39.332]], "dur": 6.19102, "start": 33.092, "end": 39.283}, {"id": "l10", "who": "S", "text": "Y para terminar, un rubor cálido, y labios rojo oscuro. Mírate.", "pad": 0.15, "words": [["Y", 39.433, 39.513], ["para", 39.593, 39.753], ["terminar,", 39.913, 40.713], ["un", 40.793, 40.873], ["rubor", 40.953, 41.273], ["cálido,", 41.353, 42.153], ["y", 42.233, 42.393], ["labios", 42.473, 42.873], ["rojo", 42.953, 43.193], ["oscuro.", 43.273, 44.153], ["Mírate.", 44.193, 44.953]], "dur": 5.485714, "start": 39.433, "end": 44.919}, {"id": "l12", "who": "Y", "text": "Lazy... estás hermosa.", "pad": 0.15, "words": [["Lazy...", 45.069, 46.029], ["estás", 46.109, 46.509], ["hermosa.", 46.669, 47.629]], "dur": 2.586122, "start": 45.069, "end": 47.655}, {"id": "l13", "who": "N", "text": "Y entonces, los tres celulares sonaron a la vez.", "pad": 0.2, "words": [["Y", 47.855, 47.935], ["entonces,", 48.055, 48.895], ["los", 48.975, 49.135], ["tres", 49.295, 49.535], ["celulares", 49.615, 50.095], ["sonaron", 50.215, 50.575], ["a", 50.615, 50.655], ["la", 50.695, 50.735], ["vez.", 50.815, 51.455]], "dur": 3.552653, "start": 47.855, "end": 51.408}, {"id": "l14", "who": "T", "text": "Última hora. La joven Mari desapareció anoche, camino a casa de una amiga.", "pad": 0.15, "words": [["Última", 51.558, 52.038], ["hora.", 52.198, 52.438], ["La", 52.918, 52.998], ["joven", 53.038, 53.318], ["Mari", 53.398, 53.638], ["desapareció", 53.758, 54.358], ["anoche,", 54.478, 55.078], ["camino", 55.198, 55.478], ["a", 55.518, 55.558], ["casa", 55.598, 55.878], ["de", 55.918, 55.958], ["una", 56.038, 56.198], ["amiga.", 56.278, 56.838]], "dur": 5.32898, "start": 51.558, "end": 56.887}, {"id": "l15", "who": "N", "text": "Mari. Iba a verla anoche, y nunca llegué.", "pad": 0.15, "words": [["Mari.", 57.037, 57.837], ["Iba", 58.077, 58.317], ["a", 58.344, 58.37], ["verla", 58.397, 58.637], ["anoche,", 58.797, 59.517], ["y", 59.557, 59.597], ["nunca", 59.677, 59.917], ["llegué.", 59.997, 60.637]], "dur": 3.552653, "start": 57.037, "end": 60.59}, {"id": "l17", "who": "S", "text": "Hija, tranquila. Llamemos a la policía. Pero así no puedes salir.", "pad": 0.15, "words": [["Hija,", 60.74, 61.3], ["tranquila.", 61.38, 62.18], ["Llamemos", 62.34, 62.74], ["a", 62.78, 62.82], ["la", 62.86, 62.9], ["policía.", 62.98, 63.86], ["Pero", 63.9, 64.1], ["así", 64.18, 64.34], ["no", 64.42, 64.58], ["puedes", 64.633, 64.9], ["salir.", 65.02, 65.62]], "dur": 4.832653, "start": 60.74, "end": 65.573}, {"id": "l18", "who": "N", "text": "Mi cabello era un desastre. Pero no podía esperar.", "pad": 0.15, "words": [["Mi", 65.723, 65.883], ["cabello", 65.923, 66.363], ["era", 66.523, 66.683], ["un", 66.763, 66.843], ["desastre.", 66.923, 68.083], ["Pero", 68.283, 68.523], ["no", 68.683, 68.843], ["podía", 68.963, 69.243], ["esperar.", 69.403, 70.123]], "dur": 4.362449, "start": 65.723, "end": 70.085}, {"id": "l19", "who": "Y", "text": "Iremos juntos, Lazy. Pero primero, ¿qué prefieres arreglar?", "pad": 0.15, "words": [["Iremos", 70.235, 70.635], ["juntos,", 70.715, 71.248], ["Lazy.", 71.382, 71.595], ["Pero", 71.995, 72.235], ["primero,", 72.395, 72.875], ["¿qué", 73.195, 73.275], ["prefieres", 73.355, 73.835], ["arreglar?", 73.875, 74.555]], "dur": 4.284082, "start": 70.235, "end": 74.519}, {"id": "l20", "who": "N", "text": "Cabello o piel. Comenta tu elección y sígueme para el día diecinueve.", "pad": 0.3, "words": [["Cabello", 74.819, 75.379], ["o", 75.539, 75.619], ["piel.", 75.699, 76.339], ["Comenta", 76.579, 76.899], ["tu", 76.939, 76.979], ["elección", 77.059, 77.619], ["y", 77.699, 77.779], ["sígueme", 77.939, 78.339], ["para", 78.419, 78.579], ["el", 78.619, 78.659], ["día", 78.739, 78.899], ["diecinueve.", 78.979, 79.859]], "dur": 4.989388, "start": 74.819, "end": 79.808}], "total": 80.81}