{"lines": [{"id": "i1", "who": "D", "text": "Ella cree que hoy se arregla sola. Qué ingenua.", "pad": 0.6, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["Ella", 0.6, 0.92], ["cree", 0.96, 1.16], ["que", 1.24, 1.32], ["hoy", 1.4, 1.56], ["se", 1.64, 1.72], ["arregla", 1.76, 2.04], ["sola.", 2.12, 2.52], ["Qué", 2.92, 3.08], ["ingenua.", 3.24, 3.96]], "dur": 3.395918, "start": 0.6, "end": 3.996}, {"id": "i2", "who": "D", "text": "Mientras se mira al espejo, yo ya tengo a alguien que no puede volver.", "pad": 0.25, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["Mientras", 4.246, 4.646], ["se", 4.726, 4.806], ["mira", 4.846, 4.966], ["al", 5.006, 5.046], ["espejo,", 5.126, 6.006], ["yo", 6.086, 6.246], ["ya", 6.286, 6.326], ["tengo", 6.486, 6.726], ["a", 6.766, 6.806], ["alguien", 6.926, 7.206], ["que", 7.286, 7.446], ["no", 7.526, 7.606], ["puede", 7.766, 8.006], ["volver.", 8.046, 8.806]], "dur": 4.519184, "start": 4.246, "end": 8.765}, {"id": "l1", "who": "N", "text": "Día dieciocho. Eligieron el maquillaje. Y todo empezó en mi casa.", "pad": 4.3, "words": [["Día", 13.065, 13.385], ["dieciocho.", 13.465, 14.585], ["Eligieron", 14.665, 15.065], ["el", 15.145, 15.185], ["maquillaje.", 15.225, 16.265], ["Y", 16.305, 16.345], ["todo", 16.505, 16.745], ["empezó", 16.825, 17.225], ["en", 17.265, 17.305], ["mi", 17.385, 17.465], ["casa.", 17.545, 18.185]], "dur": 5.067755, "start": 13.065, "end": 18.133}, {"id": "l2", "who": "Y", "text": "Ya estamos en tu casa, Lazy. Te acompañé hasta la puerta. Aquí estarás a salvo.", "pad": 0.2, "words": [["Ya", 18.333, 18.493], ["estamos", 18.573, 18.893], ["en", 18.933, 18.973], ["tu", 19.053, 19.133], ["casa,", 19.213, 19.573], ["Lazy.", 19.613, 20.413], ["Te", 20.493, 20.533], ["acompañé", 20.573, 21.053], ["hasta", 21.106, 21.213], ["la", 21.293, 21.373], ["puerta.", 21.453, 22.253], ["Aquí", 22.333, 22.653], ["estarás", 22.813, 23.213], ["a", 23.253, 23.293], ["salvo.", 23.413, 24.013]], "dur": 5.642449, "start": 18.333, "end": 23.975}, {"id": "l4", "who": "S", "text": "Hija, ¿qué te pasó? Ven, siéntate.", "pad": 1.3, "words": [["Hija,", 25.275, 25.915], ["¿qué", 25.968, 26.075], ["te", 26.155, 26.235], ["pasó?", 26.355, 27.115], ["Ven,", 27.275, 27.675], ["siéntate.", 27.755, 28.555]], "dur": 3.239184, "start": 25.275, "end": 28.514}, {"id": "lm", "who": "S", "text": "Primero, agua micelar para quitar todo lo que quedó.", "pad": 0.2, "words": [["Primero,", 28.714, 29.434], ["agua", 29.674, 29.914], ["micelar", 30.034, 30.394], ["para", 30.474, 30.634], ["quitar", 30.714, 31.114], ["todo", 31.274, 31.514], ["lo", 31.594, 31.674], ["que", 31.714, 31.754], ["quedó.", 31.834, 32.394]], "dur": 3.63102, "start": 28.714, "end": 32.345}, {"id": "lc", "who": "S", "text": "Ahora una crema fría para calmar la piel.", "pad": 0.15, "words": [["Ahora", 32.495, 32.975], ["una", 33.135, 33.295], ["crema", 33.375, 33.615], ["fría", 33.775, 34.095], ["para", 34.175, 34.335], ["calmar", 34.415, 34.815], ["la", 34.895, 34.975], ["piel.", 35.055, 35.615]], "dur": 3.082449, "start": 32.495, "end": 35.577}, {"id": "lb", "who": "N", "text": "Después, una base ligera, para unificar el tono.", "pad": 0.15, "words": [["Después,", 35.727, 36.607], ["una", 36.727, 36.847], ["base", 36.967, 37.087], ["ligera,", 37.167, 37.807], ["para", 37.887, 38.047], ["unificar", 38.127, 38.527], ["el", 38.607, 38.687], ["tono.", 38.767, 39.327]], "dur": 3.552653, "start": 35.727, "end": 39.28}, {"id": "l8", "who": "S", "text": "Ahora la sombra. Vino y ciruela, con un poco de brillo arriba. Cierra los ojos.", "pad": 0.2, "words": [["Ahora", 39.48, 39.88], ["la", 40.04, 40.12], ["sombra.", 40.2, 40.68], ["Vino", 41.24, 41.56], ["y", 41.6, 41.64], ["ciruela,", 41.72, 42.36], ["con", 42.52, 42.6], ["un", 42.68, 42.76], ["poco", 42.92, 43.16], ["de", 43.24, 43.32], ["brillo", 43.36, 43.64], ["arriba.", 43.68, 44.52], ["Cierra", 44.6, 44.84], ["los", 44.92, 45.0], ["ojos.", 45.08, 45.72]], "dur": 6.19102, "start": 39.48, "end": 45.671}, {"id": "ll", "who": "S", "text": "Un delineado fino, con una punta suave junto a la nariz.", "pad": 0.15, "words": [["Un", 45.821, 45.981], ["delineado", 46.021, 46.621], ["fino,", 46.701, 47.421], ["con", 47.501, 47.581], ["una", 47.661, 47.741], ["punta", 47.821, 48.141], ["suave", 48.221, 48.701], ["junto", 48.781, 49.021], ["a", 49.101, 49.128], ["la", 49.154, 49.181], ["nariz.", 49.261, 49.981]], "dur": 4.127347, "start": 45.821, "end": 49.948}, {"id": "l10", "who": "S", "text": "Y para terminar, un rubor cálido, y labios rojo oscuro. Mírate.", "pad": 0.15, "words": [["Y", 50.098, 50.178], ["para", 50.258, 50.418], ["terminar,", 50.578, 51.378], ["un", 51.458, 51.538], ["rubor", 51.618, 51.938], ["cálido,", 52.018, 52.818], ["y", 52.898, 53.058], ["labios", 53.138, 53.538], ["rojo", 53.618, 53.858], ["oscuro.", 53.938, 54.818], ["Mírate.", 54.858, 55.618]], "dur": 5.485714, "start": 50.098, "end": 55.584}, {"id": "l12", "who": "Y", "text": "Lazy... estás hermosa.", "pad": 0.2, "words": [["Lazy...", 55.784, 56.744], ["estás", 56.824, 57.224], ["hermosa.", 57.384, 58.344]], "dur": 2.586122, "start": 55.784, "end": 58.37}, {"id": "l13", "who": "N", "text": "Y entonces, los tres celulares sonaron a la vez.", "pad": 0.5, "words": [["Y", 58.87, 58.95], ["entonces,", 59.07, 59.91], ["los", 59.99, 60.15], ["tres", 60.31, 60.55], ["celulares", 60.63, 61.11], ["sonaron", 61.23, 61.59], ["a", 61.63, 61.67], ["la", 61.71, 61.75], ["vez.", 61.83, 62.47]], "dur": 3.552653, "start": 58.87, "end": 62.423}, {"id": "l14", "who": "T", "text": "Última hora. La joven Mari desapareció anoche, camino a casa de una amiga.", "pad": 0.3, "words": [["Última", 62.723, 63.203], ["hora.", 63.363, 63.603], ["La", 64.083, 64.163], ["joven", 64.203, 64.483], ["Mari", 64.563, 64.803], ["desapareció", 64.923, 65.523], ["anoche,", 65.643, 66.243], ["camino", 66.363, 66.643], ["a", 66.683, 66.723], ["casa", 66.763, 67.043], ["de", 67.083, 67.123], ["una", 67.203, 67.363], ["amiga.", 67.443, 68.003]], "dur": 5.32898, "start": 62.723, "end": 68.052}, {"id": "l15", "who": "N", "text": "Mari. Iba a verla anoche, y nunca llegué.", "pad": 0.3, "words": [["Mari.", 68.352, 69.152], ["Iba", 69.392, 69.632], ["a", 69.659, 69.685], ["verla", 69.712, 69.952], ["anoche,", 70.112, 70.832], ["y", 70.872, 70.912], ["nunca", 70.992, 71.232], ["llegué.", 71.312, 71.952]], "dur": 3.552653, "start": 68.352, "end": 71.905}, {"id": "l17", "who": "S", "text": "Hija, tranquila. Llamemos a la policía. Pero así no puedes salir.", "pad": 2.4, "words": [["Hija,", 74.305, 74.865], ["tranquila.", 74.945, 75.745], ["Llamemos", 75.905, 76.305], ["a", 76.345, 76.385], ["la", 76.425, 76.465], ["policía.", 76.545, 77.425], ["Pero", 77.465, 77.665], ["así", 77.745, 77.905], ["no", 77.985, 78.145], ["puedes", 78.198, 78.465], ["salir.", 78.585, 79.185]], "dur": 4.832653, "start": 74.305, "end": 79.138}, {"id": "l18", "who": "N", "text": "Mi cabello era un desastre. Pero no podía esperar.", "pad": 0.2, "words": [["Mi", 79.338, 79.498], ["cabello", 79.538, 79.978], ["era", 80.138, 80.298], ["un", 80.378, 80.458], ["desastre.", 80.538, 81.698], ["Pero", 81.898, 82.138], ["no", 82.298, 82.458], ["podía", 82.578, 82.858], ["esperar.", 83.018, 83.738]], "dur": 4.362449, "start": 79.338, "end": 83.7}, {"id": "l19", "who": "Y", "text": "Iremos juntos, Lazy. Pero primero, ¿qué prefieres arreglar?", "pad": 0.2, "words": [["Iremos", 83.9, 84.3], ["juntos,", 84.38, 84.913], ["Lazy.", 85.047, 85.26], ["Pero", 85.66, 85.9], ["primero,", 86.06, 86.54], ["¿qué", 86.86, 86.94], ["prefieres", 87.02, 87.5], ["arreglar?", 87.54, 88.22]], "dur": 4.284082, "start": 83.9, "end": 88.184}, {"id": "l20", "who": "N", "text": "Cabello o piel. Comenta tu elección y sígueme para el día diecinueve.", "pad": 0.35, "words": [["Cabello", 88.534, 89.094], ["o", 89.254, 89.334], ["piel.", 89.414, 90.054], ["Comenta", 90.294, 90.614], ["tu", 90.654, 90.694], ["elección", 90.774, 91.334], ["y", 91.414, 91.494], ["sígueme", 91.654, 92.054], ["para", 92.134, 92.294], ["el", 92.334, 92.374], ["día", 92.454, 92.614], ["diecinueve.", 92.694, 93.574]], "dur": 4.989388, "start": 88.534, "end": 93.523}], "total": 94.52}