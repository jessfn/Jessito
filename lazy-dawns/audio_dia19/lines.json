{"lines": [{"id": "i1", "who": "M", "text": "¿Hay alguien? Por favor... ayúdenme.", "pad": 0.7, "fx": "lowpass=f=1500,highpass=f=180,aecho=0.6:0.5:40:0.25", "words": [["¿Hay", 0.7, 0.94], ["alguien?", 1.02, 1.66], ["Por", 1.9, 2.06], ["favor...", 2.14, 3.02], ["ayúdenme.", 3.14, 4.06]], "dur": 3.395918, "start": 0.7, "end": 4.096}, {"id": "i2", "who": "D", "text": "Nadie te escucha aquí. Pero ella sí vendrá.", "pad": 0.5, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["Nadie", 4.596, 4.996], ["te", 5.076, 5.116], ["escucha", 5.156, 5.556], ["aquí.", 5.676, 6.356], ["Pero", 6.396, 6.596], ["ella", 6.676, 6.916], ["sí", 7.076, 7.236], ["vendrá.", 7.276, 7.956]], "dur": 3.317551, "start": 4.596, "end": 7.914}, {"id": "l1", "who": "N", "text": "Día diecinueve. Eligieron el cabello. Y mi mamá ya tenía todo listo.", "pad": 4.3, "words": [["Día", 12.214, 12.534], ["diecinueve.", 12.614, 13.574], ["Eligieron", 13.814, 14.294], ["el", 14.334, 14.374], ["cabello.", 14.454, 15.014], ["Y", 15.334, 15.414], ["mi", 15.494, 15.574], ["mamá", 15.627, 15.894], ["ya", 16.054, 16.214], ["tenía", 16.294, 16.614], ["todo", 16.774, 17.014], ["listo.", 17.094, 17.814]], "dur": 5.564082, "start": 12.214, "end": 17.778}, {"id": "l2", "who": "S", "text": "Hija, siéntate frente al espejo. Primero, un lavado con champú suave y acondicionador.", "pad": 0.3, "words": [["Hija,", 18.078, 18.718], ["siéntate", 18.798, 19.198], ["frente", 19.278, 19.518], ["al", 19.558, 19.598], ["espejo.", 19.678, 20.358], ["Primero,", 20.558, 21.118], ["un", 21.198, 21.278], ["lavado", 21.358, 21.598], ["con", 21.678, 21.838], ["champú", 21.918, 22.238], ["suave", 22.318, 22.718], ["y", 22.798, 22.838], ["acondicionador.", 22.878, 23.998]], "dur": 5.877551, "start": 18.078, "end": 23.956}, {"id": "l3", "who": "N", "text": "Después, desenredó cada mechón con un peine de dientes anchos.", "pad": 0.2, "words": [["Después,", 24.156, 25.196], ["desenredó", 25.276, 25.916], ["cada", 25.996, 26.236], ["mechón", 26.316, 26.716], ["con", 26.796, 26.956], ["un", 27.036, 27.116], ["peine", 27.196, 27.436], ["de", 27.476, 27.516], ["dientes", 27.596, 27.996], ["anchos.", 28.076, 28.956]], "dur": 4.754286, "start": 24.156, "end": 28.91}, {"id": "l4", "who": "S", "text": "Ahora, la crema definidora de rizos, y el secado con difusor.", "pad": 0.2, "words": [["Ahora,", 29.11, 29.75], ["la", 29.83, 29.91], ["crema", 29.99, 30.23], ["definidora", 30.31, 30.87], ["de", 30.91, 30.95], ["rizos,", 31.03, 31.75], ["y", 31.79, 31.83], ["el", 31.87, 31.91], ["secado", 31.99, 32.39], ["con", 32.47, 32.55], ["difusor.", 32.63, 33.43]], "dur": 4.284082, "start": 29.11, "end": 33.394}, {"id": "l5", "who": "N", "text": "Mis rizos regresaron. Mi mamá hizo la raya al centro, y alisó la parte de arriba con una plancha tibia.", "pad": 0.25, "words": [["Mis", 33.644, 33.884], ["rizos", 34.004, 34.284], ["regresaron.", 34.364, 35.404], ["Mi", 35.484, 35.564], ["mamá", 35.617, 35.804], ["hizo", 35.844, 36.044], ["la", 36.124, 36.204], ["raya", 36.324, 36.484], ["al", 36.524, 36.684], ["centro,", 36.844, 37.244], ["y", 37.324, 37.484], ["alisó", 37.644, 37.884], ["la", 37.964, 38.044], ["parte", 38.124, 38.284], ["de", 38.364, 38.404], ["arriba", 38.444, 38.844], ["con", 38.924, 39.004], ["una", 39.084, 39.244], ["plancha", 39.324, 39.644], ["tibia.", 39.724, 40.364]], "dur": 6.687347, "start": 33.644, "end": 40.331}, {"id": "l6", "who": "N", "text": "Luego, dos coletas bajas, con ligas pequeñas, y los rizos cayendo por detrás de mis hombros.", "pad": 0.2, "words": [["Luego,", 40.531, 41.211], ["dos", 41.411, 41.571], ["coletas", 41.651, 42.051], ["bajas,", 42.131, 42.691], ["con", 42.771, 42.931], ["ligas", 43.011, 43.171], ["pequeñas,", 43.251, 43.971], ["y", 44.051, 44.131], ["los", 44.211, 44.291], ["rizos", 44.371, 44.691], ["cayendo", 44.771, 45.251], ["por", 45.331, 45.411], ["detrás", 45.491, 45.811], ["de", 45.851, 45.891], ["mis", 46.011, 46.131], ["hombros.", 46.171, 46.931]], "dur": 6.347755, "start": 40.531, "end": 46.879}, {"id": "l7", "who": "Y", "text": "Lazy... te ves increíble.", "pad": 0.35, "words": [["Lazy...", 47.229, 48.269], ["te", 48.349, 48.509], ["ves", 48.629, 48.749], ["increíble.", 48.989, 49.949]], "dur": 2.690612, "start": 47.229, "end": 49.92}, {"id": "l8", "who": "N", "text": "Entonces, mi celular vibró. Número desconocido.", "pad": 1.4, "words": [["Entonces,", 51.32, 52.2], ["mi", 52.28, 52.36], ["celular", 52.44, 52.84], ["vibró.", 52.88, 53.32], ["Número", 53.8, 54.12], ["desconocido.", 54.2, 55.32]], "dur": 3.970612, "start": 51.32, "end": 55.291}, {"id": "l9", "who": "D", "text": "Si quieres recuperar a tu amiga, ven sola mañana a las diez de la noche, al bosque del Cerro Negro.", "pad": 0.35, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["Si", 55.641, 55.801], ["quieres", 55.881, 56.121], ["recuperar", 56.201, 56.681], ["a", 56.721, 56.761], ["tu", 56.801, 56.841], ["amiga,", 56.921, 57.641], ["ven", 57.721, 57.961], ["sola", 58.001, 58.281], ["mañana", 58.361, 58.681], ["a", 58.721, 58.761], ["las", 58.841, 59.001], ["diez", 59.081, 59.241], ["de", 59.321, 59.401], ["la", 59.441, 59.481], ["noche,", 59.561, 60.201], ["al", 60.281, 60.441], ["bosque", 60.521, 60.841], ["del", 60.921, 61.001], ["Cerro", 61.081, 61.321], ["Negro.", 61.401, 61.961]], "dur": 6.269388, "start": 55.641, "end": 61.91}, {"id": "l10", "who": "D", "text": "Si avisas a alguien, no volverás a verla.", "pad": 0.5, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["Si", 62.41, 62.57], ["avisas", 62.65, 63.05], ["a", 63.09, 63.13], ["alguien,", 63.21, 63.85], ["no", 63.93, 64.09], ["volverás", 64.17, 64.65], ["a", 64.69, 64.73], ["verla.", 64.85, 65.45]], "dur": 3.004082, "start": 62.41, "end": 65.414}, {"id": "l11", "who": "Y", "text": "Lazy, no puedes ir sola.", "pad": 0.3, "words": [["Lazy,", 65.714, 66.594], ["no", 66.754, 66.834], ["puedes", 66.914, 67.234], ["ir", 67.274, 67.314], ["sola.", 67.394, 68.114]], "dur": 2.35102, "start": 65.714, "end": 68.065}, {"id": "l12", "who": "N", "text": "Pero con este vestido y estos tacones, jamás llegaría corriendo por un bosque.", "pad": 0.25, "words": [["Pero", 68.315, 68.555], ["con", 68.635, 68.715], ["este", 68.795, 68.955], ["vestido", 69.035, 69.595], ["y", 69.675, 69.755], ["estos", 69.875, 70.075], ["tacones,", 70.155, 70.955], ["jamás", 71.035, 71.595], ["llegaría", 71.635, 71.995], ["corriendo", 72.075, 72.515], ["por", 72.555, 72.635], ["un", 72.715, 72.795], ["bosque.", 72.875, 73.515]], "dur": 5.146122, "start": 68.315, "end": 73.461}, {"id": "l13", "who": "N", "text": "Zapatillas o ropa. Tú decides. Comenta tu elección, comparte este video y sígueme para el día veinte.", "pad": 0.35, "words": [["Zapatillas", 73.811, 74.611], ["o", 74.771, 74.851], ["ropa.", 74.931, 75.331], ["Tú", 75.651, 75.731], ["decides.", 75.851, 76.531], ["Comenta", 76.691, 77.011], ["tu", 77.051, 77.091], ["elección,", 77.171, 77.811], ["comparte", 77.891, 78.371], ["este", 78.451, 78.531], ["video", 78.731, 78.931], ["y", 79.091, 79.171], ["sígueme", 79.251, 79.651], ["para", 79.731, 79.891], ["el", 79.931, 79.971], ["día", 80.051, 80.211], ["veinte.", 80.371, 81.091]], "dur": 7.235918, "start": 73.811, "end": 81.047}], "total": 82.05}