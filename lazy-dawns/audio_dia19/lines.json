{"lines": [{"id": "i1", "who": "M", "text": "¿Hay alguien? Por favor... ayúdenme.", "pad": 0.7, "fx": "lowpass=f=1500,highpass=f=180,aecho=0.6:0.5:40:0.25", "words": [["¿Hay", 0.7, 0.94], ["alguien?", 1.02, 1.66], ["Por", 1.9, 2.06], ["favor...", 2.14, 3.02], ["ayúdenme.", 3.14, 4.06]], "dur": 3.395918, "start": 0.7, "end": 4.096}, {"id": "i2", "who": "D", "text": "Nadie te escucha aquí. Pero ella sí vendrá.", "pad": 0.5, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["Nadie", 4.596, 4.996], ["te", 5.076, 5.116], ["escucha", 5.156, 5.556], ["aquí.", 5.676, 6.356], ["Pero", 6.396, 6.596], ["ella", 6.676, 6.916], ["sí", 7.076, 7.236], ["vendrá.", 7.276, 7.956]], "dur": 3.317551, "start": 4.596, "end": 7.914}, {"id": "l1", "who": "N", "text": "Día diecinueve. Eligieron el cabello. Y mi mamá ya tenía todo listo.", "pad": 4.3, "words": [["Día", 12.214, 12.534], ["diecinueve.", 12.614, 13.574], ["Eligieron", 13.814, 14.294], ["el", 14.334, 14.374], ["cabello.", 14.454, 15.014], ["Y", 15.334, 15.414], ["mi", 15.494, 15.574], ["mamá", 15.627, 15.894], ["ya", 16.054, 16.214], ["tenía", 16.294, 16.614], ["todo", 16.774, 17.014], ["listo.", 17.094, 17.814]], "dur": 5.564082, "start": 12.214, "end": 17.778}, {"id": "l2", "who": "S", "text": "Hija, siéntate frente al espejo. Primero, un lavado con champú suave y acondicionador.", "pad": 0.3, "words": [["Hija,", 18.078, 18.718], ["siéntate", 18.798, 19.198], ["frente", 19.278, 19.518], ["al", 19.558, 19.598], ["espejo.", 19.678, 20.358], ["Primero,", 20.558, 21.118], ["un", 21.198, 21.278], ["lavado", 21.358, 21.598], ["con", 21.678, 21.838], ["champú", 21.918, 22.238], ["suave", 22.318, 22.718], ["y", 22.798, 22.838], ["acondicionador.", 22.878, 23.998]], "dur": 5.877551, "start": 18.078, "end": 23.956}, {"id": "l3", "who": "N", "text": "Después, desenredó cada mechón con un peine de dientes anchos.", "pad": 0.2, "words": [["Después,", 24.156, 25.196], ["desenredó", 25.276, 25.916], ["cada", 25.996, 26.236], ["mechón", 26.316, 26.716], ["con", 26.796, 26.956], ["un", 27.036, 27.116], ["peine", 27.196, 27.436], ["de", 27.476, 27.516], ["dientes", 27.596, 27.996], ["anchos.", 28.076, 28.956]], "dur": 4.754286, "start": 24.156, "end": 28.91}, {"id": "l4", "who": "S", "text": "Ahora, la crema definidora de rizos, y el secado con difusor.", "pad": 0.2, "words": [["Ahora,", 29.11, 29.75], ["la", 29.83, 29.91], ["crema", 29.99, 30.23], ["definidora", 30.31, 30.87], ["de", 30.91, 30.95], ["rizos,", 31.03, 31.75], ["y", 31.79, 31.83], ["el", 31.87, 31.91], ["secado", 31.99, 32.39], ["con", 32.47, 32.55], ["difusor.", 32.63, 33.43]], "dur": 4.284082, "start": 29.11, "end": 33.394}, {"id": "l5", "who": "N", "text": "Mis rizos regresaron. Mi mamá hizo la raya al centro, y alisó la parte de arriba con una plancha tibia.", "pad": 0.25, "words": [["Mis", 33.644, 33.884], ["rizos", 34.004, 34.284], ["regresaron.", 34.364, 35.404], ["Mi", 35.484, 35.564], ["mamá", 35.617, 35.804], ["hizo", 35.844, 36.044], ["la", 36.124, 36.204], ["raya", 36.324, 36.484], ["al", 36.524, 36.684], ["centro,", 36.844, 37.244], ["y", 37.324, 37.484], ["alisó", 37.644, 37.884], ["la", 37.964, 38.044], ["parte", 38.124, 38.284], ["de", 38.364, 38.404], ["arriba", 38.444, 38.844], ["con", 38.924, 39.004], ["una", 39.084, 39.244], ["plancha", 39.324, 39.644], ["tibia.", 39.724, 40.364]], "dur": 6.687347, "start": 33.644, "end": 40.331}, {"id": "l6", "who": "N", "text": "Luego, dos coletas bajas, con ligas pequeñas, y los rizos cayendo por detrás de mis hombros.", "pad": 0.2, "words": [["Luego,", 40.531, 41.211], ["dos", 41.411, 41.571], ["coletas", 41.651, 42.051], ["bajas,", 42.131, 42.691], ["con", 42.771, 42.931], ["ligas", 43.011, 43.171], ["pequeñas,", 43.251, 43.971], ["y", 44.051, 44.131], ["los", 44.211, 44.291], ["rizos", 44.371, 44.691], ["cayendo", 44.771, 45.251], ["por", 45.331, 45.411], ["detrás", 45.491, 45.811], ["de", 45.851, 45.891], ["mis", 46.011, 46.131], ["hombros.", 46.171, 46.931]], "dur": 6.347755, "start": 40.531, "end": 46.879}, {"id": "l7", "who": "Y", "text": "Lazy... te ves increíble.", "pad": 0.35, "words": [["Lazy...", 47.229, 48.269], ["te", 48.349, 48.509], ["ves", 48.629, 48.749], ["increíble.", 48.989, 49.949]], "dur": 2.690612, "start": 47.229, "end": 49.92}, {"id": "l8", "who": "N", "text": "Entonces, mi celular vibró. Número desconocido.", "pad": 0.5, "words": [["Entonces,", 50.42, 51.3], ["mi", 51.38, 51.46], ["celular", 51.54, 51.94], ["vibró.", 51.98, 52.42], ["Número", 52.9, 53.22], ["desconocido.", 53.3, 54.42]], "dur": 3.970612, "start": 50.42, "end": 54.391}, {"id": "l9", "who": "D", "text": "Si quieres recuperar a tu amiga, ven sola mañana a las diez de la noche, al bosque del Cerro Negro.", "pad": 0.35, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["Si", 54.741, 54.901], ["quieres", 54.981, 55.221], ["recuperar", 55.301, 55.781], ["a", 55.821, 55.861], ["tu", 55.901, 55.941], ["amiga,", 56.021, 56.741], ["ven", 56.821, 57.061], ["sola", 57.101, 57.381], ["mañana", 57.461, 57.781], ["a", 57.821, 57.861], ["las", 57.941, 58.101], ["diez", 58.181, 58.341], ["de", 58.421, 58.501], ["la", 58.541, 58.581], ["noche,", 58.661, 59.301], ["al", 59.381, 59.541], ["bosque", 59.621, 59.941], ["del", 60.021, 60.101], ["Cerro", 60.181, 60.421], ["Negro.", 60.501, 61.061]], "dur": 6.269388, "start": 54.741, "end": 61.01}, {"id": "l10", "who": "D", "text": "Si avisas a alguien, no volverás a verla.", "pad": 0.5, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["Si", 61.51, 61.67], ["avisas", 61.75, 62.15], ["a", 62.19, 62.23], ["alguien,", 62.31, 62.95], ["no", 63.03, 63.19], ["volverás", 63.27, 63.75], ["a", 63.79, 63.83], ["verla.", 63.95, 64.55]], "dur": 3.004082, "start": 61.51, "end": 64.514}, {"id": "l11", "who": "Y", "text": "Lazy, no puedes ir sola.", "pad": 0.3, "words": [["Lazy,", 64.814, 65.694], ["no", 65.854, 65.934], ["puedes", 66.014, 66.334], ["ir", 66.374, 66.414], ["sola.", 66.494, 67.214]], "dur": 2.35102, "start": 64.814, "end": 67.165}, {"id": "l12", "who": "N", "text": "Pero con este vestido y estos tacones, jamás llegaría corriendo por un bosque.", "pad": 0.25, "words": [["Pero", 67.415, 67.655], ["con", 67.735, 67.815], ["este", 67.895, 68.055], ["vestido", 68.135, 68.695], ["y", 68.775, 68.855], ["estos", 68.975, 69.175], ["tacones,", 69.255, 70.055], ["jamás", 70.135, 70.695], ["llegaría", 70.735, 71.095], ["corriendo", 71.175, 71.615], ["por", 71.655, 71.735], ["un", 71.815, 71.895], ["bosque.", 71.975, 72.615]], "dur": 5.146122, "start": 67.415, "end": 72.561}, {"id": "l13", "who": "N", "text": "Zapatillas o ropa. Tú decides. Comenta tu elección, comparte este video y sígueme para el día veinte.", "pad": 0.35, "words": [["Zapatillas", 72.911, 73.711], ["o", 73.871, 73.951], ["ropa.", 74.031, 74.431], ["Tú", 74.751, 74.831], ["decides.", 74.951, 75.631], ["Comenta", 75.791, 76.111], ["tu", 76.151, 76.191], ["elección,", 76.271, 76.911], ["comparte", 76.991, 77.471], ["este", 77.551, 77.631], ["video", 77.831, 78.031], ["y", 78.191, 78.271], ["sígueme", 78.351, 78.751], ["para", 78.831, 78.991], ["el", 79.031, 79.071], ["día", 79.151, 79.311], ["veinte.", 79.471, 80.191]], "dur": 7.235918, "start": 72.911, "end": 80.147}], "total": 81.15}