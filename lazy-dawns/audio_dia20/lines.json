{"lines": [{"id": "i1", "who": "M", "text": "Un poco más... ya casi.", "pad": 0.5, "words": [["Un", 0.5, 0.643], ["poco", 0.714, 0.929], ["más...", 1.0, 1.786], ["ya", 1.857, 2.0], ["casi.", 2.071, 2.786]], "dur": 2.246531, "start": 0.5, "end": 2.747}, {"id": "i2", "who": "D", "text": "Nadie va a salvarte. Solo ella puede venir.", "pad": 0.4, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["Nadie", 3.147, 3.576], ["va", 3.611, 3.647], ["a", 3.683, 3.718], ["salvarte.", 3.79, 4.504], ["Solo", 4.718, 5.004], ["ella", 5.147, 5.433], ["puede", 5.504, 5.718], ["venir.", 5.897, 6.361]], "dur": 3.186939, "start": 3.147, "end": 6.334}, {"id": "l1", "who": "N", "text": "Día veinte. Eligieron la ropa, y no tenía tiempo que perder.", "pad": 4.2, "words": [["Día", 10.534, 10.82], ["veinte.", 10.963, 11.748], ["Eligieron", 11.82, 12.248], ["la", 12.284, 12.32], ["ropa,", 12.391, 12.82], ["y", 12.891, 12.963], ["no", 13.105, 13.177], ["tenía", 13.248, 13.605], ["tiempo", 13.677, 14.034], ["que", 14.105, 14.177], ["perder.", 14.248, 14.82]], "dur": 4.257959, "start": 10.534, "end": 14.792}, {"id": "l2", "who": "N", "text": "Tomé de mi clóset lo primero cómodo: un chaleco acolchado negro, leggings y una playera de manga larga.", "pad": 0.2, "words": [["Tomé", 14.992, 15.242], ["de", 15.278, 15.349], ["mi", 15.385, 15.421], ["clóset", 15.492, 15.849], ["lo", 15.885, 15.921], ["primero", 15.992, 16.278], ["cómodo:", 16.492, 17.278], ["un", 17.349, 17.421], ["chaleco", 17.456, 17.706], ["acolchado", 17.778, 18.206], ["negro,", 18.278, 18.921], ["leggings", 18.992, 19.563], ["y", 19.635, 19.706], ["una", 19.778, 19.921], ["playera", 19.992, 20.313], ["de", 20.349, 20.385], ["manga", 20.421, 20.635], ["larga.", 20.706, 21.278]], "dur": 6.269388, "start": 14.992, "end": 21.261}, {"id": "l3", "who": "N", "text": "A las diez de la noche, llegué sola al bosque del Cerro Negro.", "pad": 0.25, "words": [["A", 21.511, 21.582], ["las", 21.654, 21.725], ["diez", 21.797, 21.987], ["de", 22.035, 22.082], ["la", 22.118, 22.154], ["noche,", 22.225, 22.725], ["llegué", 22.797, 23.082], ["sola", 23.154, 23.44], ["al", 23.511, 23.654], ["bosque", 23.725, 24.011], ["del", 24.082, 24.154], ["Cerro", 24.225, 24.44], ["Negro.", 24.511, 25.082]], "dur": 3.552653, "start": 21.511, "end": 25.064}, {"id": "l4", "who": "D", "text": "Llegaste puntual. Si quieres a tu amiga de regreso, harás algo por mí.", "pad": 0.35, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["Llegaste", 25.414, 25.843], ["puntual.", 25.878, 26.343], ["Si", 26.771, 26.843], ["quieres", 26.914, 27.128], ["a", 27.164, 27.2], ["tu", 27.235, 27.271], ["amiga", 27.343, 27.557], ["de", 27.593, 27.628], ["regreso,", 27.7, 28.414], ["harás", 28.485, 28.771], ["algo", 28.843, 29.057], ["por", 29.128, 29.2], ["mí.", 29.271, 29.7]], "dur": 4.257959, "start": 25.414, "end": 29.672}, {"id": "l5", "who": "D", "text": "Publica un video, diciendo que jamás estarías en una pasarela de modelo.", "pad": 0.3, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["Publica", 29.972, 30.329], ["un", 30.365, 30.401], ["video,", 30.472, 31.043], ["diciendo", 31.115, 31.472], ["que", 31.543, 31.615], ["jamás", 31.686, 32.115], ["estarías", 32.186, 32.615], ["en", 32.686, 32.758], ["una", 32.829, 32.901], ["pasarela", 32.972, 33.329], ["de", 33.401, 33.472], ["modelo.", 33.686, 34.186]], "dur": 4.179592, "start": 29.972, "end": 34.152}, {"id": "l6", "who": "N", "text": "No entendí por qué. Pero no tenía opción.", "pad": 0.25, "words": [["No", 34.402, 34.545], ["entendí", 34.616, 34.973], ["por", 35.045, 35.116], ["qué.", 35.188, 35.545], ["Pero", 35.902, 36.116], ["no", 36.331, 36.402], ["tenía", 36.473, 36.688], ["opción.", 36.795, 37.402]], "dur": 3.056327, "start": 34.402, "end": 37.458}, {"id": "l7", "who": "N", "text": "Grabé el video. Mi dedo temblaba sobre publicar.", "pad": 0.25, "words": [["Grabé", 37.708, 38.041], ["el", 38.089, 38.137], ["video.", 38.315, 38.565], ["Mi", 38.922, 38.994], ["dedo", 39.065, 39.244], ["temblaba", 39.279, 39.922], ["sobre", 39.994, 40.208], ["publicar.", 40.279, 41.065]], "dur": 3.343673, "start": 37.708, "end": 41.052}, {"id": "l8", "who": "M", "text": "¡Lazy, corre!", "pad": 0.2, "words": [["¡Lazy,", 41.252, 42.038], ["corre!", 42.109, 42.823]], "dur": 1.541224, "start": 41.252, "end": 42.793}, {"id": "l9", "who": "N", "text": "Mari se había soltado. Corrimos juntas, entre los árboles.", "pad": 0.2, "words": [["Mari", 42.993, 43.279], ["se", 43.35, 43.422], ["había", 43.493, 43.707], ["soltado.", 43.779, 44.35], ["Corrimos", 44.707, 45.136], ["juntas,", 45.172, 45.779], ["entre", 45.886, 45.993], ["los", 46.064, 46.136], ["árboles.", 46.207, 46.993]], "dur": 3.970612, "start": 42.993, "end": 46.964}, {"id": "l10", "who": "D", "text": "¡No se escapen!", "pad": 0.2, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["¡No", 47.164, 47.378], ["se", 47.45, 47.521], ["escapen!", 47.628, 48.378]], "dur": 1.201633, "start": 47.164, "end": 48.366}, {"id": "l11", "who": "N", "text": "Entonces, M me empujó, y caí en el lodo.", "pad": 0.2, "words": [["Entonces,", 48.566, 49.352], ["M", 49.423, 49.709], ["me", 49.78, 49.852], ["empujó,", 49.959, 50.637], ["y", 50.709, 50.78], ["caí", 50.852, 51.209], ["en", 51.28, 51.352], ["el", 51.387, 51.423], ["lodo.", 51.495, 52.137]], "dur": 3.552653, "start": 48.566, "end": 52.119}, {"id": "l12", "who": "N", "text": "Mi ropa quedó cubierta de barro. Pero no nos detuvimos.", "pad": 0.25, "words": [["Mi", 52.369, 52.512], ["ropa", 52.583, 52.869], ["quedó", 52.905, 53.155], ["cubierta", 53.226, 53.798], ["de", 53.869, 53.94], ["barro.", 54.048, 54.726], ["Pero", 54.798, 54.94], ["no", 55.083, 55.155], ["nos", 55.226, 55.369], ["detuvimos.", 55.44, 56.298]], "dur": 3.892245, "start": 52.369, "end": 56.261}, {"id": "l13", "who": "Q", "text": "¡Alto, policía! Quédense detrás de mí.", "pad": 0.2, "words": [["¡Alto,", 56.461, 56.961], ["policía!", 56.997, 57.604], ["Quédense", 57.747, 58.104], ["detrás", 58.14, 58.39], ["de", 58.425, 58.461], ["mí.", 58.532, 58.961]], "dur": 2.481633, "start": 56.461, "end": 58.943}, {"id": "l14", "who": "N", "text": "Estábamos a salvo. Pero mi ropa estaba destruida.", "pad": 0.3, "words": [["Estábamos", 59.243, 59.814], ["a", 59.85, 59.886], ["salvo.", 59.957, 60.743], ["Pero", 60.814, 61.029], ["mi", 61.172, 61.314], ["ropa", 61.386, 61.743], ["estaba", 61.85, 62.1], ["destruida.", 62.207, 63.172]], "dur": 3.892245, "start": 59.243, "end": 63.135}, {"id": "l15", "who": "N", "text": "Ropa o zapatillas. Tú decides. Comenta tu elección, comparte este video, y sígueme para el día veintiuno.", "pad": 0.35, "words": [["Ropa", 63.485, 63.914], ["o", 64.056, 64.128], ["zapatillas.", 64.271, 65.056], ["Tú", 65.199, 65.271], ["decides.", 65.378, 66.021], ["Comenta", 66.199, 66.485], ["tu", 66.521, 66.556], ["elección,", 66.628, 67.199], ["comparte", 67.271, 67.664], ["este", 67.699, 67.842], ["video,", 67.914, 68.414], ["y", 68.449, 68.485], ["sígueme", 68.628, 68.985], ["para", 69.056, 69.128], ["el", 69.164, 69.199], ["día", 69.271, 69.414], ["veintiuno.", 69.449, 70.271]], "dur": 6.739592, "start": 63.485, "end": 70.225}], "total": 71.22}