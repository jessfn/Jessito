{"lines": [{"id": "i1", "who": "M", "text": "Un poco más... ya casi.", "pad": 0.5, "words": [["Un", 0.5, 0.643], ["poco", 0.714, 0.929], ["más...", 1.0, 1.786], ["ya", 1.857, 2.0], ["casi.", 2.071, 2.786]], "dur": 2.246531, "start": 0.5, "end": 2.747}, {"id": "i2", "who": "D", "text": "Nadie va a salvarte. Solo ella puede venir.", "pad": 0.5, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["Nadie", 3.247, 3.676], ["va", 3.711, 3.747], ["a", 3.783, 3.818], ["salvarte.", 3.89, 4.604], ["Solo", 4.818, 5.104], ["ella", 5.247, 5.533], ["puede", 5.604, 5.818], ["venir.", 5.997, 6.461]], "dur": 3.186939, "start": 3.247, "end": 6.434}, {"id": "l1", "who": "N", "text": "Día veinte. Eligieron la ropa, y no tenía tiempo que perder.", "pad": 4.2, "words": [["Día", 10.634, 10.92], ["veinte.", 11.063, 11.848], ["Eligieron", 11.92, 12.348], ["la", 12.384, 12.42], ["ropa,", 12.491, 12.92], ["y", 12.991, 13.063], ["no", 13.205, 13.277], ["tenía", 13.348, 13.705], ["tiempo", 13.777, 14.134], ["que", 14.205, 14.277], ["perder.", 14.348, 14.92]], "dur": 4.257959, "start": 10.634, "end": 14.892}, {"id": "l2", "who": "N", "text": "Tomé de mi clóset lo primero cómodo: un chaleco acolchado negro, leggings y una playera de manga larga.", "pad": 0.2, "words": [["Tomé", 15.092, 15.342], ["de", 15.378, 15.449], ["mi", 15.485, 15.521], ["clóset", 15.592, 15.949], ["lo", 15.985, 16.021], ["primero", 16.092, 16.378], ["cómodo:", 16.592, 17.378], ["un", 17.449, 17.521], ["chaleco", 17.556, 17.806], ["acolchado", 17.878, 18.306], ["negro,", 18.378, 19.021], ["leggings", 19.092, 19.663], ["y", 19.735, 19.806], ["una", 19.878, 20.021], ["playera", 20.092, 20.413], ["de", 20.449, 20.485], ["manga", 20.521, 20.735], ["larga.", 20.806, 21.378]], "dur": 6.269388, "start": 15.092, "end": 21.361}, {"id": "l3", "who": "N", "text": "A las diez de la noche, llegué sola al bosque del Cerro Negro.", "pad": 0.5, "words": [["A", 21.861, 21.932], ["las", 22.004, 22.075], ["diez", 22.147, 22.337], ["de", 22.385, 22.432], ["la", 22.468, 22.504], ["noche,", 22.575, 23.075], ["llegué", 23.147, 23.432], ["sola", 23.504, 23.79], ["al", 23.861, 24.004], ["bosque", 24.075, 24.361], ["del", 24.432, 24.504], ["Cerro", 24.575, 24.79], ["Negro.", 24.861, 25.432]], "dur": 3.552653, "start": 21.861, "end": 25.414}, {"id": "l4", "who": "D", "text": "Llegaste puntual. Si quieres a tu amiga de regreso, harás algo por mí.", "pad": 0.9, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["Llegaste", 26.314, 26.743], ["puntual.", 26.778, 27.243], ["Si", 27.671, 27.743], ["quieres", 27.814, 28.028], ["a", 28.064, 28.1], ["tu", 28.135, 28.171], ["amiga", 28.243, 28.457], ["de", 28.493, 28.528], ["regreso,", 28.6, 29.314], ["harás", 29.385, 29.671], ["algo", 29.743, 29.957], ["por", 30.028, 30.1], ["mí.", 30.171, 30.6]], "dur": 4.257959, "start": 26.314, "end": 30.572}, {"id": "l5", "who": "D", "text": "Publica un video, diciendo que jamás estarías en una pasarela de modelo.", "pad": 0.3, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["Publica", 30.872, 31.229], ["un", 31.265, 31.301], ["video,", 31.372, 31.943], ["diciendo", 32.015, 32.372], ["que", 32.443, 32.515], ["jamás", 32.586, 33.015], ["estarías", 33.086, 33.515], ["en", 33.586, 33.658], ["una", 33.729, 33.801], ["pasarela", 33.872, 34.229], ["de", 34.301, 34.372], ["modelo.", 34.586, 35.086]], "dur": 4.179592, "start": 30.872, "end": 35.052}, {"id": "l6", "who": "N", "text": "No entendí por qué. Pero no tenía opción.", "pad": 0.4, "words": [["No", 35.452, 35.595], ["entendí", 35.666, 36.023], ["por", 36.095, 36.166], ["qué.", 36.238, 36.595], ["Pero", 36.952, 37.166], ["no", 37.381, 37.452], ["tenía", 37.523, 37.738], ["opción.", 37.845, 38.452]], "dur": 3.056327, "start": 35.452, "end": 38.508}, {"id": "l7", "who": "N", "text": "Grabé el video. Mi dedo temblaba sobre publicar.", "pad": 0.3, "words": [["Grabé", 38.808, 39.141], ["el", 39.189, 39.237], ["video.", 39.415, 39.665], ["Mi", 40.022, 40.094], ["dedo", 40.165, 40.344], ["temblaba", 40.379, 41.022], ["sobre", 41.094, 41.308], ["publicar.", 41.379, 42.165]], "dur": 3.343673, "start": 38.808, "end": 42.152}, {"id": "l8", "who": "M", "text": "¡Lazy, corre!", "pad": 1.4, "words": [["¡Lazy,", 43.552, 44.338], ["corre!", 44.409, 45.123]], "dur": 1.541224, "start": 43.552, "end": 45.093}, {"id": "l9", "who": "N", "text": "Mari se había soltado. Corrimos juntas, entre los árboles.", "pad": 0.15, "words": [["Mari", 45.243, 45.529], ["se", 45.6, 45.672], ["había", 45.743, 45.957], ["soltado.", 46.029, 46.6], ["Corrimos", 46.957, 47.386], ["juntas,", 47.422, 48.029], ["entre", 48.136, 48.243], ["los", 48.314, 48.386], ["árboles.", 48.457, 49.243]], "dur": 3.970612, "start": 45.243, "end": 49.214}, {"id": "l10", "who": "D", "text": "¡No se escapen!", "pad": 0.9, "fx": "asetrate=44100*0.8,aresample=44100,atempo=1.25,aecho=0.8:0.7:70|140:0.4|0.25,highpass=f=80", "words": [["¡No", 50.114, 50.328], ["se", 50.4, 50.471], ["escapen!", 50.578, 51.328]], "dur": 1.201633, "start": 50.114, "end": 51.316}, {"id": "l11", "who": "N", "text": "Entonces, M me empujó, y caí en el lodo.", "pad": 0.9, "words": [["Entonces,", 52.216, 53.002], ["M", 53.073, 53.359], ["me", 53.43, 53.502], ["empujó,", 53.609, 54.287], ["y", 54.359, 54.43], ["caí", 54.502, 54.859], ["en", 54.93, 55.002], ["el", 55.037, 55.073], ["lodo.", 55.145, 55.787]], "dur": 3.552653, "start": 52.216, "end": 55.769}, {"id": "l12", "who": "N", "text": "Mi ropa quedó cubierta de barro. Pero no nos detuvimos.", "pad": 0.3, "words": [["Mi", 56.069, 56.212], ["ropa", 56.283, 56.569], ["quedó", 56.605, 56.855], ["cubierta", 56.926, 57.498], ["de", 57.569, 57.64], ["barro.", 57.748, 58.426], ["Pero", 58.498, 58.64], ["no", 58.783, 58.855], ["nos", 58.926, 59.069], ["detuvimos.", 59.14, 59.998]], "dur": 3.892245, "start": 56.069, "end": 59.961}, {"id": "l13", "who": "Q", "text": "¡Alto, policía! Quédense detrás de mí.", "pad": 1.3, "words": [["¡Alto,", 61.261, 61.761], ["policía!", 61.797, 62.404], ["Quédense", 62.547, 62.904], ["detrás", 62.94, 63.19], ["de", 63.225, 63.261], ["mí.", 63.332, 63.761]], "dur": 2.481633, "start": 61.261, "end": 63.743}, {"id": "l14", "who": "N", "text": "Estábamos a salvo. Pero mi ropa estaba destruida.", "pad": 0.4, "words": [["Estábamos", 64.143, 64.714], ["a", 64.75, 64.786], ["salvo.", 64.857, 65.643], ["Pero", 65.714, 65.929], ["mi", 66.072, 66.214], ["ropa", 66.286, 66.643], ["estaba", 66.75, 67.0], ["destruida.", 67.107, 68.072]], "dur": 3.892245, "start": 64.143, "end": 68.035}, {"id": "l15", "who": "N", "text": "Ropa o zapatillas. Tú decides. Comenta tu elección, comparte este video, y sígueme para el día veintiuno.", "pad": 0.5, "words": [["Ropa", 68.535, 68.964], ["o", 69.106, 69.178], ["zapatillas.", 69.321, 70.106], ["Tú", 70.249, 70.321], ["decides.", 70.428, 71.071], ["Comenta", 71.249, 71.535], ["tu", 71.571, 71.606], ["elección,", 71.678, 72.249], ["comparte", 72.321, 72.714], ["este", 72.749, 72.892], ["video,", 72.964, 73.464], ["y", 73.499, 73.535], ["sígueme", 73.678, 74.035], ["para", 74.106, 74.178], ["el", 74.214, 74.249], ["día", 74.321, 74.464], ["veintiuno.", 74.499, 75.321]], "dur": 6.739592, "start": 68.535, "end": 75.275}], "total": 76.28}