# Copia de ejemplo de /etc/gamesdata.env (el real vive SOLO en el VPS, nunca en git)
PORT=3077
DATA_DIR=/var/lib/gamesdata
ALLOWED_ORIGINS=https://jessfn.github.io
MAX_UPLOAD_BYTES=4294967296
# PostgreSQL local sin contraseña (autenticación del sistema con el usuario "gamesdata")
PGHOST=/var/run/postgresql
PGDATABASE=gamesdata
PGUSER=gamesdata
# Los crea poner-contrasena.js:
# PASSWORD_HASH=scrypt:<sal>:<huella>
# TOKEN_SECRET=<aleatorio>
